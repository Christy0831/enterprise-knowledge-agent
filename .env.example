# Offline mock needs no configuration.
# Copy to .env; real-mode CLI auto-loads it. Shell variables take precedence.
# Keep one KEY=value per line. No variable expansion or inline comments.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional OpenAI backend (not required when using DeepSeek).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

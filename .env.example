# Offline mock needs no configuration.
# Copy to .env; real-mode CLI auto-loads it. Shell variables take precedence.
# Keep one KEY=value per line. No variable expansion or inline comments.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional hybrid retrieval. Official model identifier is text-embedding-v4.
# Fill the key in local .env. Region of key and endpoint must match.
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
DASHSCOPE_TIMEOUT=15

# Optional OpenAI backend (not required when using DeepSeek).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
